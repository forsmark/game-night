# The container sets DATABASE_PATH and PORT itself. Only change these when running without it.
DATABASE_PATH=./data/game-night.db
PORT=3002
# Don't set NODE_ENV here. It is development unless the container or `pnpm start` makes it production.
# Public address of the app. Magic links use it. In dev, point it at the Vite server.
BASE_URL=http://localhost:5173
# Optional. BoardGameGeek XML API token, for game search and box images.
# Without it, games are imported from a CSV or typed in by hand.
# Register an application at https://boardgamegeek.com/applications
BGG_TOKEN=
