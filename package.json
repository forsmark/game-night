{
  "name": "game-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "esbuild src/server/index.ts src/server/seed/host-link.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist-server",
    "start": "cross-env NODE_ENV=production tsx src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "host:link": "tsx src/server/seed/host-link.ts",
    "seed:demo": "tsx src/server/seed/seed-demo.ts",
    "icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
