# Podman Quadlet: runs Game Night as a systemd user service.
# Install: cp deploy/game-night.container ~/.config/containers/systemd/
#          systemctl --user daemon-reload && systemctl --user start game-night
# Quadlet generates the service, so there is no "enable": [Install] below starts it at boot.
[Unit]
Description=Game Night
After=network-online.target

[Container]
ContainerName=game-night
Image=localhost/game-night:latest
# Only reachable from this machine, on port 3002. Tailscale Funnel forwards to it.
# The app listens on 3000 inside the container.
PublishPort=127.0.0.1:3002:3000
# The image keeps the database in /data. The volume's contents don't depend on where it's mounted.
Volume=game-night-data:/data
# BASE_URL, SHARE_BASE_URL and BGG_TOKEN. See .env.example.
EnvironmentFile=%h/game-night/.env
# Set here as well, so a PORT or DATABASE_PATH copied into .env from .env.example can't move them.
Environment=PORT=3000 DATABASE_PATH=/data/game-night.db
HealthCmd=wget -qO- http://localhost:3000/healthz
HealthInterval=30s

[Service]
Restart=always

[Install]
WantedBy=default.target
